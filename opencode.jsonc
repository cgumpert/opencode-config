{
  "$schema": "https://opencode.ai/config.json",

  // Global OpenCode configuration — applies to every project for this user.
  // Merged below project config: ancestor opencode.json(c) files override
  // these settings, and .opencode/opencode.json(c) files override those.
  //
  // Terminal-only preferences (theme, keybinds, sessions) live in cli.json
  // and are ignored if placed here.
  "plugins": [
    "@plannotator/opencode@latest"
  ],

  // Format files after write/edit/patch. Runs a built-in only when its
  // executable or project dependency is present, so this is a no-op in
  // projects with no matching formatter.
  "formatter": true,

  // Don't let build output trigger filesystem updates and snapshot churn.
  "watcher": {
    "ignore": [
      "dist/**",
      "build/**",
      "coverage/**",
      "node_modules/**",
      "*.lock",
    ],
  },

  // Compact long sessions automatically instead of waiting for a manual
  // /compact that you'll forget to run.
  "compaction": {
    "auto": true,
    "keep": { "tokens": 15000 },
    "buffer": 20000,
  },

  // Base policy is already "* allow", so this is a pure guardrail: the
  // last matching rule wins, and nothing re-allows it.
  "permissions": [
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
  ],

  "commands": {
    "commit": {
      "description": "Commit the staged changes",
      "template": "Inspect the staged changes with `git diff --cached`, write a concise commit message describing what changed and why, then commit with `git commit`.",
    },
    "push": {
      "description": "Push the current branch to its upstream remote",
      "template": "Push the commits of the current branch with a plain `git push`. Do not name a remote or a branch — let git use the upstream configured for the current branch. If git reports that no upstream is set, report that and ask which remote to use instead of guessing. Show the resulting status.",
    },
  },

  "mcp": {
    "servers": {
      // Official AWS MCP server. Searches AWS docs, CDK and CloudFormation guidance,
      // regional availability, and agent skills. Can retrieve service information,
      // execute AWS API calls and run Python scripts in sandboxed environments
      // using  existing IAM credentials.
      "aws": {
        "type": "remote",
        "url": "https://aws-mcp.eu-central-1.api.aws/mcp",
      },

      // HashiCorp Terraform MCP server — public Terraform Registry lookups
      // (providers, modules, policies). Runs in Docker over stdio; no HCP
      // Terraform credentials configured, so registry toolset only. Widen
      // later with "--toolsets=all" or TFE_ADDRESS/TFE_TOKEN in
      // `environment` (use {env:TFE_TOKEN}) if needed.
      "terraform": {
        "type": "local",
        "command": [
          "docker",
          "run",
          "-i",
          "--rm",
          "hashicorp/terraform-mcp-server:1.3.0",
          "--toolsets=registry",
        ],
      },

      // Github MCP server — local stdio server authenticated as a GitHub App,
      // so agent actions (comments, reviews, issues, PRs) are attributed to
      // <app-name>[bot] instead of me personally. The server mints and
      // auto-refreshes installation tokens internally; the private key is
      // mounted read-only into the container and never enters config or env.
      // NOTE: the remote server (https://api.githubcopilot.com/mcp/) cannot
      // use GitHub App auth — it only accepts a static PAT/OAuth bearer token.
      //
      // The app needs permissions matching its toolsets (e.g. Contents,
      // Issues, Pull requests: Read & write).
      "github": {
        "type": "local",
        "command": [
          "docker", "run", "-i", "--rm",
          // Absolute path: docker resolves relative bind mounts against the
          // session's working directory, so a relative path would only work
          // from sessions located in this directory.
          "-v", "{env:GITHUB_APP_PRIVATE_KEY_PEM}:/secrets/github-app.pem:ro",
          "-e", "GITHUB_APP_ID={env:GITHUB_APP_ID}",
          "-e", "GITHUB_APP_INSTALLATION_ID={env:GITHUB_APP_INSTALLATION_ID}",
          "-e", "GITHUB_APP_PRIVATE_KEY_PATH=/secrets/github-app.pem",
          "-e", "GITHUB_TOOLSETS=default,actions",
          "ghcr.io/github/github-mcp-server:v2.0.3",
        ],
      },
    },
  },
}
